# Port number for Express server
PORT=5000

# Environment: development or production
NODE_ENV=development

# MongoDB connection URI (use your MongoDB Atlas connection string in production)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/looplearnDB?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/looplearnDB

# Frontend client URL for CORS handling (e.g. http://localhost:5173 for local, https://your-site.netlify.app for production)
FRONTEND_URL=http://localhost:5173

# Secret key for signing JSON Web Tokens (min 32 random characters recommended)
JWT_SECRET=your_jwt_secret_key_here_at_least_32_characters_long

# JWT token expiration time (e.g. 7d)
JWT_EXPIRES_IN=7d

# Cookie domain/security settings (set true in production with HTTPS)
COOKIE_SECURE=false
